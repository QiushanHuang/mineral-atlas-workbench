{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mineral-atlas.local/schema/editor-v2.json",
  "title": "Mineral Atlas reference geometry draft v2",
  "description": "Offline Cartesian half-spaces. Unknown crystallographic facts remain unknown. Basis columns are independent reference axes; axes.origin does not translate the solid.",
  "type": "object",
  "required": ["schema_version", "id", "title", "planes", "axes", "history"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "title": {"type": "string"},
    "geometry_source": {"const": "cartesian_planes"},
    "planes": {
      "type": "array", "minItems": 4, "maxItems": 96,
      "items": {"$ref": "#/$defs/plane"}
    },
    "axes": {"$ref": "#/$defs/axes"},
    "geometry_origin": {"$ref": "#/$defs/vector"},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "parent_fingerprint", "result_fingerprint", "geometry_changed", "algorithm_version"],
        "properties": {
          "command": {"$ref": "#/$defs/command"},
          "parent_fingerprint": {"$ref": "#/$defs/fingerprint"},
          "result_fingerprint": {"$ref": "#/$defs/fingerprint"},
          "geometry_changed": {"type": "boolean"},
          "algorithm_version": {"type": "string"}
        }
      }
    },
    "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "source_indexing": {
      "type": "object", "required": ["basis", "index_count", "status"],
      "properties": {
        "basis": {"$ref": "#/$defs/basis"},
        "index_count": {"enum": [3, 4]},
        "status": {"type": "string"}
      }
    },
    "reference_symmetry": {
      "type": "object", "required": ["basis", "point_group", "crystal_system", "status"],
      "properties": {
        "basis": {"$ref": "#/$defs/basis"},
        "point_group": {"type": "string"},
        "crystal_system": {"type": "string"},
        "status": {"const": "imported_reference"}
      }
    },
    "registration_status": {"enum": ["not_registered", "current", "needs_refit"]},
    "units": {"const": "model_relative_units"},
    "preset": {"enum": ["box", "triangular_prism", "hexagonal_prism", "pyramid", "dipyramid", "rhombohedron", "truncated_box"]},
    "algorithm_version": {"type": "string"},
    "claim_boundary": {"type": "string"}
  },
  "$defs": {
    "vector": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "basis": {"type": "array", "items": {"$ref": "#/$defs/vector"}, "minItems": 3, "maxItems": 3},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "face_ids": {"type": "array", "items": {"type": "string", "pattern": "^F[0-9]{2,3}$"}, "minItems": 1, "uniqueItems": true},
    "distance": {"type": "number", "minimum": 0.00001, "maximum": 10000},
    "plane": {
      "type": "object", "required": ["id", "normal", "distance", "label", "module", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9]{2,3}$"},
        "normal": {"$ref": "#/$defs/vector", "description": "Unit outward normal. Normalization, uniqueness, closure and active faces are checked by the shared local geometry core."},
        "distance": {"$ref": "#/$defs/distance"},
        "label": {"type": "string"},
        "module": {"type": "string", "description": "Preset: body/top/bottom/bevel. Imported faces: single unless an explicit grouping source exists."},
        "evidence": {"type": "string"},
        "source_hkl": {"type": "array", "items": {"type": "integer", "minimum": -9999, "maximum": 9999}, "minItems": 3, "maxItems": 4},
        "photo_label": {"type": "string"}
      }
    },
    "axes": {
      "type": "object", "required": ["basis", "index_count", "origin", "status"],
      "properties": {
        "basis": {"$ref": "#/$defs/basis", "description": "Right-handed nonsingular basis; columns are a,b,c or a1,a2,c. Four-axis requires equal basal lengths and angles 90,90,120 degrees; a3=-a1-a2."},
        "index_count": {"enum": [3, 4]},
        "origin": {"$ref": "#/$defs/vector", "description": "Reference marker only, independent of the geometric internal origin."},
        "status": {"const": "user_reference"}
      }
    },
    "command": {
      "oneOf": [
        {"type": "object", "required": ["type", "face_ids", "delta"], "properties": {"type": {"const": "move_faces"}, "face_ids": {"$ref": "#/$defs/face_ids"}, "delta": {"type": "number"}, "scope": {"enum": ["selected", "module", "opposite"]}}},
        {"type": "object", "required": ["type", "factors"], "properties": {"type": {"const": "scale"}, "factors": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.0001, "maximum": 10000}}}},
        {"type": "object", "required": ["type", "normal", "distance"], "properties": {"type": {"const": "truncate"}, "normal": {"$ref": "#/$defs/vector"}, "distance": {"$ref": "#/$defs/distance"}, "id": {"type": "string", "pattern": "^F[0-9]{2,3}$"}, "label": {"type": "string"}, "evidence": {"type": "string"}}},
        {"type": "object", "required": ["type", "basis"], "properties": {"type": {"enum": ["set_axes", "rebuild_axes"]}, "basis": {"$ref": "#/$defs/basis"}, "index_count": {"enum": [3, 4]}, "origin": {"$ref": "#/$defs/vector"}}},
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "metadata"}, "face_ids": {"$ref": "#/$defs/face_ids"}, "title": {"type": "string"}, "label": {"type": "string"}, "evidence": {"type": "string"}}, "dependentRequired": {"label": ["face_ids"], "evidence": ["face_ids"]}},
        {"type": "object", "required": ["type", "face_ids"], "properties": {"type": {"const": "set_plane"}, "face_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^F[0-9]{2,3}$"}}, "normal": {"$ref": "#/$defs/vector"}, "distance": {"$ref": "#/$defs/distance"}}}
      ]
    }
  }
}
