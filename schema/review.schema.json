{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineral-atlas:review-response:1",
  "title": "Offline review response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "input_sha256", "policy_sha256", "suggestions", "uncertain"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string", "pattern": "^review-[0-9a-f]{24}$"},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "suggestions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/suggestion"}},
    "uncertain": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "basis": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vector"}},
    "annotation_feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "points"],
      "dependentRequired": {"face_id": ["model_fingerprint"]},
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["edge", "silhouette", "face", "occlusion", "uncertain"]},
        "points": {"type": "array", "minItems": 2, "maxItems": 500, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "face_id": {"type": "string", "pattern": "^F[0-9]{2,3}$"},
        "model_fingerprint": {"$ref": "#/$defs/hash", "description": "Per-feature model binding; must equal the packet input_sha256 whenever face_id is present."}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_sha256", "image_size", "features", "provenance"],
      "properties": {
        "schema_version": {"const": 1},
        "source_sha256": {"$ref": "#/$defs/hash"},
        "image_size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "features": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/annotation_feature"}},
        "provenance": {"const": "unverified_user_drawn"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference", "detail"],
      "properties": {
        "kind": {"enum": ["model_face", "model_summary", "user_annotation"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 200},
        "detail": {"$ref": "#/$defs/text"}
      }
    },
    "suggestion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "target", "reason", "evidence", "command"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target": {"enum": ["geometry", "axes"]},
        "reason": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/evidence"}},
        "command": {"oneOf": [{"$ref": "#/$defs/move"}, {"$ref": "#/$defs/axes"}, {"$ref": "#/$defs/truncate"}]}
      }
    },
    "move": {
      "type": "object", "additionalProperties": false, "required": ["type", "face_ids", "delta"],
      "properties": {"type": {"const": "move_faces"}, "face_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "delta": {"type": "number"}, "scope": {"enum": ["selected", "module", "opposite"]}}
    },
    "axes": {
      "type": "object", "additionalProperties": false, "required": ["type", "basis", "index_count"],
      "properties": {"type": {"const": "set_axes"}, "basis": {"$ref": "#/$defs/basis"}, "index_count": {"enum": [3, 4]}, "origin": {"$ref": "#/$defs/vector"}}
    },
    "truncate": {
      "type": "object", "additionalProperties": false, "required": ["type", "normal", "distance"],
      "properties": {"type": {"const": "truncate"}, "normal": {"$ref": "#/$defs/vector"}, "distance": {"type": "number", "exclusiveMinimum": 0}, "id": {"type": "string", "pattern": "^F[0-9]{2,3}$"}, "label": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/text"}}
    }
  }
}
