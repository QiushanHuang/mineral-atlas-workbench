{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mineral Atlas Project v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "crystal_system",
    "point_group",
    "basis"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string"
    },
    "crystal_system": {
      "enum": [
        "三斜",
        "单斜",
        "正交",
        "四方",
        "三方",
        "六方",
        "等轴"
      ]
    },
    "point_group": {
      "enum": [
        "1",
        "-1",
        "2",
        "m",
        "2/m",
        "222",
        "mm2",
        "mmm",
        "4",
        "-4",
        "4/m",
        "422",
        "4mm",
        "-42m",
        "4/mmm",
        "3",
        "-3",
        "32",
        "3m",
        "-3m",
        "6",
        "-6",
        "6/m",
        "622",
        "6mm",
        "-6m2",
        "6/mmm",
        "23",
        "m-3",
        "432",
        "-43m",
        "m-3m"
      ]
    },
    "index_count": {
      "enum": [
        3,
        4
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      }
    },
    "expected_faces": {
      "type": "integer",
      "minimum": 4,
      "maximum": 96
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {
        "type": "object",
        "required": [
          "hkl",
          "distance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{2,3}$"
          },
          "hkl": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                }
              }
            ]
          },
          "distance": {
            "type": "number",
            "minimum": 1e-05,
            "maximum": 10000
          },
          "expand": {
            "type": "boolean"
          },
          "photo_label": {
            "type": [
              "string",
              "integer"
            ]
          },
          "label": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "faces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 96,
      "items": {
        "type": "object",
        "required": [
          "hkl",
          "distance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{2,3}$"
          },
          "hkl": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                }
              }
            ]
          },
          "distance": {
            "type": "number",
            "minimum": 1e-05,
            "maximum": 10000
          },
          "expand": {
            "type": "boolean"
          },
          "photo_label": {
            "type": [
              "string",
              "integer"
            ]
          },
          "label": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "forms"
      ],
      "not": {
        "required": [
          "faces"
        ]
      }
    },
    {
      "required": [
        "faces"
      ],
      "not": {
        "required": [
          "forms"
        ]
      }
    }
  ],
  "additionalProperties": false
}